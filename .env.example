# Copy this file to .env.local and fill in your values

# MySQL Database (Hostinger provides this in hPanel → Databases → MySQL)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# Your live domain (or http://localhost:3000 for development)
NEXTAUTH_URL="https://yourdomain.com"

# Admin credentials used when seeding the database
ADMIN_EMAIL="admin@okunsfamilytravel.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
